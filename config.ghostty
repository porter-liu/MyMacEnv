# ============================================================
# Ghostty Configuration (macOS)
# ~/.config/ghostty/config.ghostty
# ============================================================


# ------------------------------------------------------------
# 1. Fonts & Typography
# ------------------------------------------------------------

# 英文主字体：包含编程符号及 Nerd Font 图标
font-family = "JetBrainsMonoNL Nerd Font Mono"

# 中文 fallback 字体：保留其他候选字体，方便切换
#font-family = "Sarasa Term Lumi X"
#font-family = "Noto Sans Mono CJK SC"
font-family = "Maple Mono CN"

# 字体大小（pt）
# macOS 会自动使用 Apple Color Emoji 显示彩色表情
font-size = 20

# 增加字符单元高度 5%，近似 WezTerm 的 line_height = 1.05
adjust-cell-height = 5%


# ------------------------------------------------------------
# 2. Theme & Colors
# ------------------------------------------------------------

# Catppuccin Mocha 主题
theme = "Catppuccin Mocha"

# 覆盖主题背景色，使用 Catppuccin Mocha 的 Mantle
background = #181825


# ------------------------------------------------------------
# 3. Window & Tab Bar
# ------------------------------------------------------------

# 使用 macOS 原生标签栏
macos-titlebar-style = tabs

# 窗口标题字体
window-title-font-family = "SF Pro"

# 终端内容与窗口边缘的间距（像素）
window-padding-x = 8
window-padding-y = 6

# 不自动平衡左右/上下 padding，保持指定的边距
window-padding-balance = false


# ------------------------------------------------------------
# 4. Cursor
# ------------------------------------------------------------

# 竖线光标，并启用闪烁
cursor-style = bar
cursor-style-blink = true


# ------------------------------------------------------------
# 5. Mouse & Clipboard
# ------------------------------------------------------------

# 鼠标滚轮速度倍率
# discrete：传统滚轮；precision：触控板/高精度滚动
mouse-scroll-multiplier = discrete:1,precision:1

# 鼠标选中文本后，自动复制到系统剪贴板
copy-on-select = clipboard


# ------------------------------------------------------------
# 6. Shell Integration & SSH
# ------------------------------------------------------------

# ssh-env：向远程 SSH 会话传递相关终端环境信息
# ssh-terminfo：自动处理远程主机缺失的 Ghostty terminfo
# no-cursor：禁止 Shell Integration 覆盖上面设置的光标样式
shell-integration-features = ssh-env,ssh-terminfo,no-cursor


# ------------------------------------------------------------
# 7. Keyboard Shortcuts
# ------------------------------------------------------------

# 全局快捷键 Ctrl+Option+Space
# 从任意 macOS 应用呼出或隐藏 Quick Terminal
keybind = global:ctrl+alt+space=toggle_quick_terminal
