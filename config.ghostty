# 1. 字体与 fallback
# 主字体提供英文字母、编程符号和 Nerd Font 图标
font-family = "JetBrainsMonoNL Nerd Font Mono"

# fallback 用于中文及主字体不包含的字符
#font-family = "Sarasa Term Lumi X"
#font-family = "Noto Sans Mono CJK SC"
font-family = "Maple Mono CN"

# Apple Color Emoji 在 macOS 上会自动使用
# 粗体也会自动匹配两种字体的 Bold 样式
font-size = 20

# 近似对应 WezTerm line_height = 1.05
adjust-cell-height = 5%


# 2. 颜色
theme = "Catppuccin Mocha"

# 使用原来的 mantle 作为终端背景
background = #181825


# 3. macOS 标签栏
# 把 Tab Bar 融合到系统标题栏
macos-titlebar-style = tabs

# 标题字体，字号和字重无法独立精确控制
window-title-font-family = "SF Pro"


# 4. 窗口内边距
window-padding-x = 8
window-padding-y = 6
window-padding-balance = false


# 5. 光标
# BlinkngBar -> bar + blink
cursor-style = bar
cursor-style-blink = true

# 如果 shell integration 覆盖光标样式，
# 可以尝试取消下一行的注释：
# shell-integration-features = no-cursor


# SSH 时自动安装远程机器缺少的 Ghostty terminfo。
# 安装失败时回退到 xterm-256color。
# 同时尝试转发 Ghostty 相关的终端环境信息。
shell-integration-features = ssh-env,ssh-terminfo

